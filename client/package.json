{
  "name": "verse-client",
  "description": "Verse web client",
  "private": true,
  "type": "module",
  "webpackPort": "8020",
  "scripts": {
    "clean": "rimraf build node_modules",
    "start": "webpack-dev-server --config webpack.dev.js",
    "compile": "npm-run-all --aggregate-output --continue-on-error --parallel typecheck lint format",
    "typecheck": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "webpack": "cross-env NODE_ENV=production webpack --config webpack.prod.js",
    "format": "prettier --check \"./*.js\" \"src/**/*.{ts,tsx}\"",
    "format:fix": "prettier --write \"./*.js\" \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/compat": "^1.2.1",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.6.2",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@types/webpack-env": "^1.18.0",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "^10.2.4",
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "fork-ts-checker-webpack-plugin": "^6.5.2",
    "globals": "^14.0.0",
    "html-webpack-plugin": "^5.5.0",
    "kill-port": "^2.0.1",
    "mini-css-extract-plugin": "^2.6.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "react-refresh": "^0.18.0",
    "react-refresh-typescript": "^2.0.11",
    "rimraf": "^6.1.0",
    "source-map-loader": "^3.0.2",
    "terser-webpack-plugin": "^5.3.6",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack": "5.94.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.11.1",
    "webpack-merge": "^5.7.3"
  },
  "engines": {
    "node": ">=22"
  }
}
