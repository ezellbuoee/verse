# Copy to compose/.env.prod (git-ignored) and fill in. Generate secrets with: openssl rand -base64 36
PROJECT_NAME=verse
VERSE_PUBLIC_URL=https://verse.example.org
VERSE_DB_NAME=verse
VERSE_DB_USERNAME=verse
VERSE_DB_PASSWORD=change-me-long-random
VERSE_JWT_SECRET=change-me-at-least-32-random-characters
# Bootstrap admin: created on first start, promoted if it exists. Remove both once you have your own admin.
VERSE_ADMIN_EMAIL=you@example.org
VERSE_ADMIN_PASSWORD=change-me-long-random
# Images: built locally by --build, or pulled from your registry
SERVER_IMAGE=verse/server:2.0.0
FRONTEND_IMAGE=verse/frontend:2.0.0
