{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "name": "client start",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": [ "start" ],
            "cwd": "${workspaceFolder}/client"
        },
        {
            "type": "chrome",
            "name": "client start [debug]",
            "request": "launch",
            "url": "http://localhost:8020",
            "runtimeExecutable": "stable",
            "webRoot": "${workspaceFolder}/client",
            "preLaunchTask": "start client",
            "postDebugTask": "stop client",
            "sourceMaps": true
        },
        {
            "type": "java",
            "name": "server start (dev, H2)",
            "request": "launch",
            "mainClass": "com.verse.server.VerseServerApplication",
            "args": ["--spring.profiles.active=dev"],
            "cwd": "${workspaceFolder}/server",
            "projectName": "server"
        },
        {
            "type": "java",
            "name": "server start (dev, compose Postgres)",
            "request": "launch",
            "mainClass": "com.verse.server.VerseServerApplication",
            "args": ["--spring.profiles.active=dev,local-db"],
            "cwd": "${workspaceFolder}/server",
            "projectName": "server"
        }
    ]
}
