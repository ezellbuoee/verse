<?xml version="1.0"?>
<!DOCTYPE import-control PUBLIC
        "-//Checkstyle//DTD ImportControl Configuration 1.4//EN"
        "https://checkstyle.org/dtds/import_control_1_4.dtd">
<!-- Keeps implementation-internal packages of libraries out of Verse code. -->
<import-control pkg="com.verse.server*" strategyOnMismatch="allowed" regex="true">
    <allow class="com.verse.server(\.\w+)*\.internal(\.\w+)*" regex="true" />
    <disallow class=".*\.internal(\.\w+)*" regex="true" />
</import-control>
